-- ALTER TABLE coverage for built-in columnar tables.
CREATE SCHEMA columnar_alter;
SET search_path TO columnar_alter, public;
SET columnar.compression TO 'none';
CREATE TABLE alter_test(a int, b int, c int) USING columnar;
INSERT INTO alter_test VALUES (1, 2, 3), (4, 5, 6), (7, 8, 9);
ALTER TABLE alter_test DROP COLUMN a;
ANALYZE alter_test;
SELECT * FROM alter_test ORDER BY b, c;
 b | c 
---+---
 2 | 3
 5 | 6
 8 | 9
(3 rows)

SELECT a FROM alter_test;
ERROR:  column "a" does not exist
LINE 1: SELECT a FROM alter_test;
               ^
INSERT INTO alter_test SELECT 3, 5, 8;
ERROR:  INSERT has more expressions than target columns
LINE 1: INSERT INTO alter_test SELECT 3, 5, 8;
                                            ^
INSERT INTO alter_test SELECT 5, 8;
ALTER TABLE alter_test ADD COLUMN d int;
SELECT * FROM alter_test ORDER BY b, c, d NULLS FIRST;
 b | c | d 
---+---+---
 2 | 3 |  
 5 | 6 |  
 5 | 8 |  
 8 | 9 |  
(4 rows)

INSERT INTO alter_test SELECT 3, 5, 8;
SELECT * FROM alter_test ORDER BY b, c, d NULLS FIRST;
 b | c | d 
---+---+---
 2 | 3 |  
 3 | 5 | 8
 5 | 6 |  
 5 | 8 |  
 8 | 9 |  
(5 rows)

ALTER TABLE alter_test ADD COLUMN e int DEFAULT 3;
SELECT * FROM alter_test ORDER BY b, c, d NULLS FIRST, e;
 b | c | d | e 
---+---+---+---
 2 | 3 |   | 3
 3 | 5 | 8 | 3
 5 | 6 |   | 3
 5 | 8 |   | 3
 8 | 9 |   | 3
(5 rows)

INSERT INTO alter_test SELECT 1, 2, 4, 8;
SELECT * FROM alter_test ORDER BY b, c, d NULLS FIRST, e;
 b | c | d | e 
---+---+---+---
 1 | 2 | 4 | 8
 2 | 3 |   | 3
 3 | 5 | 8 | 3
 5 | 6 |   | 3
 5 | 8 |   | 3
 8 | 9 |   | 3
(6 rows)

ALTER TABLE alter_test ADD COLUMN f text DEFAULT 'TEXT ME';
INSERT INTO alter_test SELECT 1, 2, 4, 8, 'ABCDEF';
ALTER TABLE alter_test DROP COLUMN c;
ALTER TABLE alter_test DROP COLUMN e;
ANALYZE alter_test;
SELECT * FROM alter_test ORDER BY b, d NULLS FIRST, f;
 b | d |    f    
---+---+---------
 1 | 4 | ABCDEF
 1 | 4 | TEXT ME
 2 |   | TEXT ME
 3 | 8 | TEXT ME
 5 |   | TEXT ME
 5 |   | TEXT ME
 8 |   | TEXT ME
(7 rows)

SELECT count(*) FROM alter_test;
 count 
-------
     7
(1 row)

SELECT count(t.*) FROM alter_test t;
 count 
-------
     7
(1 row)

ALTER TABLE alter_test ADD COLUMN g boolean DEFAULT isfinite(current_date);
SELECT * FROM alter_test ORDER BY b, d NULLS FIRST, f;
ERROR:  unsupported default value for column "g"
HINT:  Expression is either mutable or does not evaluate to constant value
ALTER TABLE alter_test ALTER COLUMN g DROP DEFAULT;
ALTER TABLE alter_test ADD COLUMN h date DEFAULT current_date;
SELECT * FROM alter_test ORDER BY b, d NULLS FIRST, f;
ERROR:  unsupported default value for column "h"
HINT:  Expression is either mutable or does not evaluate to constant value
ALTER TABLE alter_test ALTER COLUMN h DROP DEFAULT;
ALTER TABLE alter_test ADD COLUMN i int;
ALTER TABLE alter_test ADD COLUMN j float4;
ALTER TABLE alter_test ADD COLUMN k text;
ALTER TABLE alter_test ALTER COLUMN i TYPE float4;
ALTER TABLE alter_test ALTER COLUMN j TYPE int;
ALTER TABLE alter_test ALTER COLUMN k TYPE varchar(20);
ALTER TABLE alter_test ALTER COLUMN k TYPE text;
ALTER TABLE alter_test RENAME COLUMN k TO k_renamed;
ALTER TABLE alter_test RENAME TO alter_test_renamed;
DROP TABLE alter_test_renamed;
CREATE DOMAIN str_domain AS text NOT NULL;
CREATE TABLE domain_test(a int, b int) USING columnar;
INSERT INTO domain_test VALUES (1, 2), (1, 2);
ALTER TABLE domain_test ADD COLUMN c str_domain;
ERROR:  domain str_domain does not allow null values
ALTER TABLE domain_test ADD COLUMN c str_domain DEFAULT 'x';
SELECT * FROM domain_test ORDER BY a, b, c;
 a | b | c 
---+---+---
 1 | 2 | x
 1 | 2 | x
(2 rows)

BEGIN;
ALTER TABLE domain_test ADD COLUMN d int DEFAULT random();
ROLLBACK;
BEGIN;
ALTER TABLE domain_test ADD COLUMN d serial;
SELECT * FROM domain_test ORDER BY a, b, c, d;
 a | b | c | d 
---+---+---+---
 1 | 2 | x | 1
 1 | 2 | x | 2
(2 rows)

ROLLBACK;
SET default_table_access_method TO columnar;
CREATE TABLE volatile_default AS
SELECT * FROM generate_series(1, 10) id;
ALTER TABLE volatile_default ADD COLUMN col4 int DEFAULT (random() * 10000)::int;
SELECT id, col4 < 10000 AS default_in_range
FROM volatile_default
ORDER BY id;
 id | default_in_range 
----+------------------
  1 | t
  2 | t
  3 | t
  4 | t
  5 | t
  6 | t
  7 | t
  8 | t
  9 | t
 10 | t
(10 rows)

RESET default_table_access_method;
CREATE TABLE identity_test(a int) USING columnar;
INSERT INTO identity_test VALUES (1), (2), (3);
ALTER TABLE identity_test ADD COLUMN c int GENERATED BY DEFAULT AS IDENTITY;
SELECT * FROM identity_test ORDER BY a;
 a | c 
---+---
 1 | 1
 2 | 2
 3 | 3
(3 rows)

CREATE TABLE generated_test(x int) USING columnar;
INSERT INTO generated_test VALUES (1), (2), (3);
ALTER TABLE generated_test ADD COLUMN y int GENERATED ALWAYS AS (x + 1) STORED;
SELECT * FROM generated_test ORDER BY x;
 x | y 
---+---
 1 | 2
 2 | 3
 3 | 4
(3 rows)

BEGIN;
CREATE TABLE local_zero_col(y int);
INSERT INTO local_zero_col VALUES (1), (2);
ALTER TABLE local_zero_col DROP COLUMN y;
CREATE TABLE zero_col_columnar (LIKE local_zero_col) USING columnar;
ALTER TABLE local_zero_col RENAME TO local_zero_col_source;
INSERT INTO zero_col_columnar SELECT * FROM local_zero_col_source;
COMMIT;
SELECT * FROM zero_col_columnar;
--
(2 rows)

SELECT count(*) FROM zero_col_columnar;
 count 
-------
     2
(1 row)

INSERT INTO zero_col_columnar DEFAULT VALUES;
INSERT INTO zero_col_columnar DEFAULT VALUES;
SELECT count(*) FROM zero_col_columnar;
 count 
-------
     4
(1 row)

VACUUM zero_col_columnar;
ANALYZE zero_col_columnar;
VACUUM FULL zero_col_columnar;
TRUNCATE zero_col_columnar;
SELECT count(*) FROM zero_col_columnar;
 count 
-------
     0
(1 row)

CREATE TABLE products (
    product_no int,
    name text,
    price int CONSTRAINT price_constraint CHECK (price > 0)
) USING columnar;
INSERT INTO products VALUES (1, 'bread', 0);
ERROR:  new row for relation "products" violates check constraint "price_constraint"
DETAIL:  Failing row contains (1, bread, 0).
INSERT INTO products VALUES (1, 'bread', 10);
ALTER TABLE products ADD CONSTRAINT dummy_constraint CHECK (price > product_no);
INSERT INTO products VALUES (2, 'shampoo', 1);
ERROR:  new row for relation "products" violates check constraint "dummy_constraint"
DETAIL:  Failing row contains (2, shampoo, 1).
INSERT INTO products VALUES (2, 'shampoo', 20);
ALTER TABLE products DROP CONSTRAINT dummy_constraint;
INSERT INTO products VALUES (3, 'pen', 2);
SELECT * FROM products ORDER BY product_no;
 product_no |  name   | price 
------------+---------+-------
          1 | bread   |    10
          2 | shampoo |    20
          3 | pen     |     2
(3 rows)

CREATE TABLE products_unique(
    product_no int UNIQUE,
    name text,
    price numeric
) USING columnar;
INSERT INTO products_unique VALUES (1, 'bread', 10);
INSERT INTO products_unique VALUES (1, 'bread', 10);
ERROR:  duplicate key value violates unique constraint "products_unique_product_no_key"
DETAIL:  Key (product_no)=(1) already exists.
RESET search_path;
DROP SCHEMA columnar_alter CASCADE;
NOTICE:  drop cascades to 9 other objects
DETAIL:  drop cascades to type columnar_alter.str_domain
drop cascades to table columnar_alter.domain_test
drop cascades to table columnar_alter.volatile_default
drop cascades to table columnar_alter.identity_test
drop cascades to table columnar_alter.generated_test
drop cascades to table columnar_alter.local_zero_col_source
drop cascades to table columnar_alter.zero_col_columnar
drop cascades to table columnar_alter.products
drop cascades to table columnar_alter.products_unique
