CREATE TABLE agg_date(a date) USING columnar;
INSERT INTO agg_date VALUES
    ('2000-01-01'),
    ('2020-01-01'),
    ('2010-01-01'),
    ('2000-01-02');
EXPLAIN (VERBOSE, COSTS OFF, TIMING OFF, SUMMARY OFF)
SELECT min(a), max(a)
FROM agg_date;
                            QUERY PLAN                            
------------------------------------------------------------------
 Custom Scan (VectorAggNode)
   Output: (columnar.vmin(a)), (columnar.vmax(a))
   ->  Custom Scan (ColumnarScan) on columnar_aggregates.agg_date
         Output: a
         Columnar Projected Columns: a
(5 rows)

SELECT min(a), max(a)
FROM agg_date;
    min     |    max     
------------+------------
 01-01-2000 | 01-01-2020
(1 row)

CREATE TABLE agg_mixed(a int, b bigint, c date, d time) USING columnar;
INSERT INTO agg_mixed VALUES
    (0, 1000, '2000-01-01', '23:50'),
    (10, 2000, '2010-01-01', '00:50');
EXPLAIN (VERBOSE, COSTS OFF, TIMING OFF, SUMMARY OFF)
SELECT min(d)
FROM agg_mixed;
                            QUERY PLAN                             
-------------------------------------------------------------------
 Aggregate
   Output: min(d)
   ->  Custom Scan (ColumnarScan) on columnar_aggregates.agg_mixed
         Output: d
         Columnar Projected Columns: d
(5 rows)

EXPLAIN (VERBOSE, COSTS OFF, TIMING OFF, SUMMARY OFF)
SELECT sum(a + b)
FROM agg_mixed;
                            QUERY PLAN                             
-------------------------------------------------------------------
 Aggregate
   Output: sum((a + b))
   ->  Custom Scan (ColumnarScan) on columnar_aggregates.agg_mixed
         Output: a, b
         Columnar Projected Columns: a, b
(5 rows)

EXPLAIN (VERBOSE, COSTS OFF, TIMING OFF, SUMMARY OFF)
SELECT count(1)
FROM agg_mixed;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Aggregate
   Output: count(1)
   ->  Custom Scan (ColumnarScan) on columnar_aggregates.agg_mixed
         Columnar Projected Columns: <columnar optimized out all columns>
(4 rows)

EXPLAIN (VERBOSE, COSTS OFF, TIMING OFF, SUMMARY OFF)
SELECT count(DISTINCT a)
FROM agg_mixed;
                               QUERY PLAN                                
-------------------------------------------------------------------------
 Aggregate
   Output: count(DISTINCT a)
   ->  Sort
         Output: a
         Sort Key: agg_mixed.a
         ->  Custom Scan (ColumnarScan) on columnar_aggregates.agg_mixed
               Output: a
               Columnar Projected Columns: a
(8 rows)

CREATE TABLE agg_filter(a int) USING columnar;
INSERT INTO agg_filter
SELECT g
FROM generate_series(0, 100) g;
EXPLAIN (VERBOSE, COSTS OFF, TIMING OFF, SUMMARY OFF)
SELECT count(a) FILTER (WHERE a > 90)
FROM agg_filter;
                             QUERY PLAN                             
--------------------------------------------------------------------
 Aggregate
   Output: count(a) FILTER (WHERE (a > 90))
   ->  Custom Scan (ColumnarScan) on columnar_aggregates.agg_filter
         Output: a
         Columnar Projected Columns: a
(5 rows)

SELECT count(a) FILTER (WHERE a > 90)
FROM agg_filter;
 count 
-------
    10
(1 row)

RESET max_parallel_workers_per_gather;
RESET search_path;
DROP SCHEMA columnar_aggregates CASCADE;
NOTICE:  drop cascades to 6 other objects
DETAIL:  drop cascades to table columnar_aggregates.agg_smallint
drop cascades to table columnar_aggregates.agg_int
drop cascades to table columnar_aggregates.agg_bigint
drop cascades to table columnar_aggregates.agg_date
drop cascades to table columnar_aggregates.agg_mixed
drop cascades to table columnar_aggregates.agg_filter
